# Cloudflare Pages Function secrets for local testing.
# Copy to .dev.vars and replace the placeholder values. Never commit .dev.vars.
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret
LEAD_WEBHOOK_URL=https://replace-with-your-secure-lead-webhook.example

# Public Astro build variable, configured in Cloudflare Pages build settings.
PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
