---
// Layout for every page except the homepage: version 6 header, page body, orange footer.
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Pill from '../components/Pill.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	noindex?: boolean;
	footerCta?: boolean;
	mobileBar?: boolean;
	turnstile?: boolean;
}

const { title, description, image, noindex = false, footerCta = true, mobileBar = true, turnstile = false } = Astro.props;
---

<!doctype html>
<html lang="en-CA">
	<head>
		<SiteHead title={title} description={description} image={image} noindex={noindex} />
	</head>
	<body>
		<div class="r5 inner">
			<a class="skip" href="#main">Skip to content</a>
			<SiteHeader />
			<main id="main"><slot /></main>
			{mobileBar && <div class="mbar"><Pill href="/contact/" tone="or" icon="none">Get a plan</Pill></div>}
			<SiteFooter cta={footerCta} />
		</div>
		<script is:inline src="/assets/js/v6.js?v=3" defer></script>
		{turnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
	</body>
</html>
