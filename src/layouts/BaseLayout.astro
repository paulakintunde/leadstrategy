---
// Layout for every page except the homepage: version 6 header, page body, orange footer.
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Pill from '../components/Pill.astro';
import type { Crumb } from '../data/org';

interface Props {
	title: string;
	description: string;
	image?: string;
	noindex?: boolean;
	footerCta?: boolean;
	mobileBar?: boolean;
	turnstile?: boolean;
	crumbs?: Crumb[];
	pageType?: string;
	schema?: Record<string, unknown>[];
}

const { title, description, image, noindex = false, footerCta = true, mobileBar = true, turnstile = false, crumbs, pageType, schema } = Astro.props;
// Cloudflare Email Obfuscation rewrites every address into a script-only link that crawlers
// read as "[email protected]" and that 404s without JavaScript. These markers exclude the page.
const EMAIL_OFF = '<!--email_off-->';
const EMAIL_ON = '<!--/email_off-->';
---

<!doctype html>
<html lang="en-CA">
	<head>
		<SiteHead title={title} description={description} image={image} noindex={noindex} crumbs={crumbs} pageType={pageType} schema={schema} />
		<link rel="stylesheet" href="/assets/css/v6-soft.css?v=2" />
	</head>
	<body>
		<Fragment set:html={EMAIL_OFF} />
		<div class="r5 inner">
			<a class="skip" href="#main">Skip to content</a>
			<SiteHeader />
			<main id="main"><slot /></main>
			{mobileBar && <div class="mbar"><Pill href="/contact/" tone="or" icon="none">Get a plan</Pill></div>}
			<SiteFooter cta={footerCta} />
		</div>
		<script is:inline src="/assets/js/v6.js?v=4" defer></script>
		{turnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
		<Fragment set:html={EMAIL_ON} />
	</body>
</html>
