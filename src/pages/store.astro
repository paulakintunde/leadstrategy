---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Pill from '../components/Pill.astro';
import { softwareApp } from '../utils/schema';

const schema = [
	softwareApp({
		name: 'FincWin',
		url: 'https://www.fincwin.com/',
		description: 'A free personal money-management app for iOS and Android that brings income, spending, debt and savings into one view.',
		category: 'FinanceApplication',
		os: 'iOS, Android',
		image: '/images/v6/work-fincwin.webp',
	}),
];
---
<BaseLayout title="Our Apps, Including FincWin | Lead Strategy" description="Software Lead Strategy builds and runs itself, including FincWin, a free budgeting app for iOS and Android that tracks income, spending, debt and savings." crumbs={[{ name: 'Our products', path: '/store/' }]} schema={schema}>
	<PageIntro
		kicker="Our products"
		title="Our own products."
		lead="Alongside client work, Lead Strategy Canada Inc. builds and publishes software of its own."
		chips={['Lead Strategy Canada Inc.', 'Built and published in Canada']}
		icon="shopping-bag"
		primary={{ href: 'https://www.fincwin.com', label: 'Visit fincwin.com', external: true }}
		secondary={{ href: '/about/', label: 'About the company' }}
	/>

	<section class="prodx wrap" id="fincwin" aria-labelledby="fw-h">
		<div class="pxgrid" data-rv>
			<div class="pxtxt">
				<span class="lbl k">iOS and Android</span>
				<h2 class="sh" id="fw-h">FincWin</h2>
				<p class="sub">FincWin is a personal money-management app for iOS and Android. It brings income, spending, debt and savings into one view.</p>
				<p class="sub">Lead Strategy Canada Inc. builds and publishes FincWin.</p>
				<Pill href="https://www.fincwin.com" tone="dk" icon="out" external>Visit fincwin.com</Pill>
			</div>
			<a class="case" href="https://www.fincwin.com" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
				<span class="cimg laptop">
					<span class="lid"><span class="scr"><img src="/images/v6/work-fincwin.webp" srcset="/images/v6/work-fincwin-640.webp 640w, /images/v6/work-fincwin.webp 1280w" sizes="(max-width: 760px) 90vw, 45vw" alt="FincWin on a laptop" loading="lazy" decoding="async" width="1280" height="800" /></span></span>
					<span class="deck"></span>
				</span>
			</a>
		</div>
		<div class="glance" data-rv>
			<span class="lbl">At a glance</span>
			<ul class="ledger">
				<li>Product<span>FincWin, a personal money-management app</span></li>
				<li>Platforms<span>iOS and Android</span></li>
				<li>Publisher<span>Lead Strategy Canada Inc.</span></li>
				<li>Website<a href="https://www.fincwin.com" target="_blank" rel="noopener">www.fincwin.com<span class="vh"> (opens in a new tab)</span></a></li>
			</ul>
		</div>
	</section>

	<section class="band wrap" aria-labelledby="sell-h">
		<div class="bgrid" data-rv>
			<div class="btxt">
				<span class="lbl k">For clients</span>
				<h2 class="sh" id="sell-h">We also run the commerce side for other businesses.</h2>
			</div>
			<div class="btxt">
				<p class="sub">Catalogue, pricing, promotions, customer questions, download delivery and merch fulfilment, run day to day, with a weekly trading summary instead of an admin panel.</p>
				<Pill href="/services/#sell" tone="dk">See the Sell division</Pill>
			</div>
		</div>
	</section>
</BaseLayout>
