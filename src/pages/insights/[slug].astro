---
// One article per insight: /insights/<slug>/. Content lives in src/data/insights.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Sections from '../../components/Sections.astro';
import NextLinks from '../../components/NextLinks.astro';
import Pill from '../../components/Pill.astro';
import { INSIGHT_PAGES } from '../../data/insights';
import { sectorCard, insightCard, servicePath, sectorPath, serviceBySlug, sectorBySlug, insightPath } from '../../data/catalog';
import { article, person } from '../../utils/schema';
import { personBySlug, personPath } from '../../data/people';
import type { InsightPage } from '../../data/types';

export function getStaticPaths() {
	return INSIGHT_PAGES.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props as { a: InsightPage };
const sec = sectorCard(a.sector);
const card = insightCard(a.slug);
const path = insightPath(a.slug);
const fmt = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const dateText = fmt(a.published);
const updated = a.updated && a.updated !== a.published ? a.updated : undefined;
const author = personBySlug(a.author);

// Other insights: the next two in the list, so every article links onward.
const idx = INSIGHT_PAGES.findIndex((x) => x.slug === a.slug);
const more = [1, 2].map((k) => INSIGHT_PAGES[(idx + k) % INSIGHT_PAGES.length]);

const schema = [
	article({ path, headline: a.headline, description: a.description, published: a.published, modified: updated, image: card.img, section: sec.name, about: [sec.name, ...a.services.map((x) => serviceBySlug(x).name)], author }),
	...(author ? [person(author)] : []),
];
---
<BaseLayout
	title={`${a.title} | Lead Strategy`}
	description={a.description}
	image={card.img}
	crumbs={[{ name: 'Insights', path: '/insights/' }, { name: a.headline, path }]}
	schema={schema}
>
	<PageIntro
		kicker={sec.short}
		trail={[{ href: '/insights/', label: 'Insights' }]}
		title={a.headline}
		lead={a.lead}
		chips={[{ href: sectorPath(a.sector), label: sec.name }, `Published ${dateText}`, author ? author.name : 'Lead Strategy']}
		icon="lightbulb"
		primary={{ href: '/contact/', label: 'Ask us to look at your site' }}
		secondary={{ href: sectorPath(a.sector), label: `Websites for ${sec.name.toLowerCase()}` }}
	/>

	<div class="dtl wrap">
		<article class="prose">
			<p class="ameta">By {author ? <a href={personPath(author.slug)}>{author.name}</a> : 'Lead Strategy'} · <time datetime={a.published}>{dateText}</time>{updated && <> · Updated <time datetime={updated}>{fmt(updated)}</time></>}</p>
			<figure class="dimg"><img src={card.img} alt="" width="1280" height="800" decoding="async" fetchpriority="high" /></figure>
			<Sections sections={a.sections} />
		</article>
		<aside class="aside" aria-label="Checklist">
			<div class="abox">
				<h2>Check your own site</h2>
				<ul class="ticks">{a.checklist.map((c) => <li>{c}</li>)}</ul>
			</div>
			<div class="abox">
				<h2>Related services</h2>
				<ul class="tags">{a.services.map((x) => <li><a href={servicePath(x)}>{serviceBySlug(x).name}</a></li>)}</ul>
			</div>
			<div class="abox abox-dk">
				<p>Sounds familiar? Tell us what is happening and we will look at your site before we reply.</p>
				<Pill href="/contact/" tone="or">Get a plan</Pill>
			</div>
		</aside>
	</div>

	<NextLinks
		heading="More insights."
		id="rel-h"
		items={[
			{ href: sectorPath(a.sector), kicker: 'Sector', title: sectorBySlug(a.sector).h1, line: sectorBySlug(a.sector).lead, cta: 'Read the sector page' },
			...more.map((m) => ({ href: insightPath(m.slug), kicker: sectorCard(m.sector).short, title: m.headline, line: m.lead, cta: 'Read the article' })),
		]}
	/>
</BaseLayout>
