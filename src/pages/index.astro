---
import V6Layout from '../layouts/V6Layout.astro';

// The contact form posts to /api/contact only when a Turnstile site key is configured.
// Without it, the form opens the visitor's email app with the message filled in.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const live = Boolean(siteKey);
---

<V6Layout
	title="Lead Strategy | Websites, search, ads and commerce in Canada"
	description="Lead Strategy builds fast websites, search visibility, advertising and commerce for Canadian small businesses and nonprofits. Build, Market, Create, Sell."
	turnstile={live}
>
<div class="r5">
  <a class="skip" href="#r6work">Skip to content</a>
  <header class="hero" id="r5top">
    <div class="card">
      <img src="/images/v6/hero-shop.webp" alt>
      <nav class="nav" aria-label="Main">
        <a class="logo" href="#r5top"><img src="/images/v6/umbrella.webp" alt>Lead Strategy</a>
        <div class="links">
          <a href="#r6work">Work</a>
          <a href="#r5svc">Services</a>
          <a href="#r5prod">Products</a>
          <a href="#r6ins">Insights</a>
          <a href="#r5faq">Questions</a>
        </div>
        <div class="navr">
          <a class="pill p-or" href="#r5contact">Get a plan<span class="ar"><svg class="pi a1" viewBox="0 0 256 256" aria-hidden="true"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/></svg><svg class="pi a2" viewBox="0 0 256 256" aria-hidden="true"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/></svg></span></a>
          <button type="button" class="mbtn" aria-expanded="false" aria-controls="r5sheet" data-menu><svg class="pi" viewBox="0 0 256 256" aria-hidden="true"><path d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z" data-list="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z" data-x="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"/></svg><span>Menu</span></button>
        </div>
      </nav>
      <div class="sheet" id="r5sheet" hidden>
          <a href="#r6work" data-close>Work</a>
          <a href="#r5svc" data-close>Services</a>
          <a href="#r5prod" data-close>Our products</a>
          <a href="#r6ins" data-close>Insights</a>
          <a href="#r5faq" data-close>Questions</a>
          <a href="#r5contact" data-close>Get a plan</a>
        </div>
      <div class="hcopy">
        <h1 aria-label="We are Lead Strategy."><span class="wd"><span style="--i:0">We</span></span> <span class="wd"><span style="--i:1">are</span></span> <span class="wd"><span style="--i:2"><em>Lead</em></span></span> <span class="wd"><span style="--i:3"><em>Strategy.</em></span></span></h1>
        <p>One Canadian team for small businesses, freelancers and specialist practices. We also build and run our own apps and software.</p>
        <div class="btns">
          <a class="pill p-or" href="#r5contact" data-mag>Get a plan<span class="ar"><svg class="pi a1" viewBox="0 0 256 256" aria-hidden="true"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/></svg><svg class="pi a2" viewBox="0 0 256 256" aria-hidden="true"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/></svg></span></a>
          <a class="pill p-wh solo" href="#r5who">Find your starting point</a>
        </div>
      </div>
