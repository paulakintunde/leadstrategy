---
import Icon from './Icon.astro';
import { WORK } from '../data/site';
---
<div class="wgrid" data-rv>
	{WORK.map((w) => (
		<a class="case" href={w.url} target="_blank" rel="noopener">
			<span class="cimg laptop">
				<span class="lid"><span class="scr"><img src={w.img} srcset={`${w.img.replace(".webp", "-640.webp")} 640w, ${w.img} 1280w`} sizes="(max-width: 760px) 90vw, 30vw" alt={w.alt} loading="lazy" decoding="async" width="1280" height="800" /></span></span>
				<span class="deck" aria-hidden="true"></span>
			</span>
			<span class="ctx">
				<span class="cm lbl">{w.cat}</span>
				<b>{w.name}</b>
				<span class="cd">{w.line}</span>
				<span class="rd">{w.domain}<Icon name="out" /><span class="vh">(opens in a new tab)</span></span>
			</span>
		</a>
	))}
</div>
