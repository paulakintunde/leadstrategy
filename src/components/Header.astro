---
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;
const isStore = pathname.startsWith('/store/');
const nav = [
	{ href: '/services/', label: 'Services' },
	{ href: '/sectors/', label: 'Sectors' },
	{ href: '/work/', label: 'Work' },
	{ href: '/insights/', label: 'Insights' },
	{ href: '/store/', label: 'Store' },
	{ href: '/about/', label: 'About' },
];

const current = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<a class="skip" href="#main">Skip to content</a>
<div class="progress" aria-hidden="true"><i></i></div>
<header class="site-head">
	<div class="bar">
		<a href="/" aria-label="Lead Strategy, home"><Logo /></a>
		<nav class="nav" aria-label="Primary">
			{nav.map((item) => (
				<a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>
			))}
		</nav>
		{isStore ? (
			<a class="head-cta" href="#main">Cart · <span id="cart-count">0</span></a>
		) : (
			<a class="head-cta" href="/contact/">Contact us</a>
		)}
		<button class="burger" type="button" aria-expanded="false" aria-controls="drawer" aria-label="Menu"><i></i><i></i><i></i></button>
	</div>
	<div class="drawer" id="drawer">
		<ul>
			{nav.map((item) => (
				<li><a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a></li>
			))}
			<li><a class="d-cta" href="/contact/">Contact us</a></li>
		</ul>
	</div>
</header>
