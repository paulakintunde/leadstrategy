---
import Icon from './Icon.astro';

interface Props {
	items: { href: string; kicker: string; title: string; line: string; cta?: string }[];
	heading?: string;
	id?: string;
}
const { items, heading = 'Where to go next.', id = 'next-h' } = Astro.props;
---
<section class="next wrap" aria-labelledby={id}>
	<h2 class="sh sh-s" id={id} data-rv>{heading}</h2>
	<div class="ngrid" data-rv>
		{items.map((n) => (
			<a class="nx" href={n.href}>
				<span class="lbl">{n.kicker}</span>
				<b>{n.title}</b>
				<span class="nd">{n.line}</span>
				<span class="rd">{n.cta ?? `Go to ${n.kicker}`}<Icon name="arrow" /></span>
			</a>
		))}
	</div>
</section>
