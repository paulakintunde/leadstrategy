---
// Page heading for every page except the homepage.
interface Props {
	kicker: string;
	title: string;
	lead?: string;
	chips?: string[];
}

const { kicker, title, lead, chips = [] } = Astro.props;
---
<section class="phead wrap">
	<div class="pht">
		<span class="lbl k">{kicker}</span>
		<h1>{title}</h1>
		{lead && <p class="sub">{lead}</p>}
		{chips.length > 0 && <ul class="tags tags-l">{chips.map((c) => <li>{c}</li>)}</ul>}
		<slot />
	</div>
	<img class="pumb" src="/images/v6/umbrella.webp" alt="" aria-hidden="true" width="581" height="507" />
</section>
