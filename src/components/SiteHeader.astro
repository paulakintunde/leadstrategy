---
import Icon from './Icon.astro';
import Pill from './Pill.astro';
import { NAV, isCurrent } from './nav';

const path = Astro.url.pathname;
const listPath = 'M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z';
const xPath = 'M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z';
---
<header class="top" id="r5top">
	<nav class="nav" aria-label="Main">
		<a class="logo" href="/"><img src="/images/v6/umbrella.webp" alt="" width="581" height="507" />Lead Strategy</a>
		<div class="links">
			{NAV.map((n) => <a href={n.href} aria-current={isCurrent(path, n.href) ? 'page' : undefined}>{n.label}</a>)}
		</div>
		<div class="navr">
			<Pill href="/contact/" tone="or" icon="out">Get a plan</Pill>
			<button type="button" class="mbtn" aria-expanded="false" aria-controls="r5sheet" data-menu>
				<svg class="pi" viewBox="0 0 256 256" aria-hidden="true"><path d={listPath} data-list={listPath} data-x={xPath} /></svg><span>Menu</span>
			</button>
		</div>
	</nav>
	<div class="sheet" id="r5sheet" hidden>
		<a href="/" data-close>Home</a>
		{NAV.map((n) => <a href={n.href} data-close aria-current={isCurrent(path, n.href) ? 'page' : undefined}>{n.label}</a>)}
		<a href="/contact/" data-close>Get a plan</a>
	</div>
</header>
