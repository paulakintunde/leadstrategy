---
import Pill from './Pill.astro';
import { PUBLISHED } from '../pseo/registry';
import { ORG, LOCATION_LINE } from '../data/org';

interface Props {
	cta?: boolean;
}
const { cta = true } = Astro.props;
const hasGuides = PUBLISHED.some((r) => r.type !== 'profession');
---
<footer class:list={['ft', { 'ft-slim': !cta }]} id="r5contact">
	<div class="wrap">
		{cta && (
			<div class="fg">
				<div>
					<span class="belief lbl">You own everything we build</span>
					<h2>Tell us what you run.</h2>
					<p class="lead">Tell us what needs to happen first. We scope it in writing and phase it so each step pays for the next.</p>
				</div>
				<div class="fcta">
					<Pill href="/contact/" tone="wh" icon="arrow" mag>Get a plan</Pill>
					<p class="alt">Prefer email? Write to <a href="mailto:hello@leadstrategy.ca">hello@leadstrategy.ca</a></p>
				</div>
			</div>
		)}
		<div class="fcols">
			<div><span class="lbl">Divisions</span><a href="/services/#build">Build</a><a href="/services/#market">Market</a><a href="/services/#create">Create</a><a href="/services/#sell">Sell</a><a href="https://www.fincwin.com" target="_blank" rel="noopener">FincWin</a></div>
			<div><span class="lbl">Company</span><a href="/work/">Work</a><a href="/sectors/">Sectors</a><a href="/about/">About</a><a href="/insights/">Insights</a>{hasGuides && <a href="/guides/">Guides</a>}<a href="/store/">Our products</a></div>
			<div><span class="lbl">Get in touch</span><a href="mailto:hello@leadstrategy.ca">hello@leadstrategy.ca</a>{ORG.telephone && <a href={`tel:${ORG.telephone}`}>{ORG.telephoneDisplay ?? ORG.telephone}</a>}<a href="/contact/">Contact page</a><span>{LOCATION_LINE}</span></div>
		</div>
		<div class="fbar"><span>© {new Date().getFullYear()} Lead Strategy Canada Inc., registered in Canada</span><nav aria-label="Footer"><a href="/services/">Services</a><a href="/sectors/">Sectors</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/accessibility/">Accessibility</a></nav></div>
	</div>
	<div class="word" aria-hidden="true" data-rv><span class="wi">Lead Strategy</span></div>
</footer>
