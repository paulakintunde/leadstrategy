---
// Renders content sections as H2 + paragraphs + optional list, inside .prose.
import type { Section } from '../data/types';

interface Props {
	sections: Section[];
}
const { sections } = Astro.props;
---
{sections.map((s) => (
	<Fragment>
		<h2>{s.h2}</h2>
		{s.body.map((p) => <p>{p}</p>)}
		{s.list && s.list.length > 0 && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
	</Fragment>
))}
