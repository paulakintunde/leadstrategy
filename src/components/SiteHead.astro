---
interface Props {
	title: string;
	description: string;
	image?: string;
	noindex?: boolean;
	preloadHero?: boolean;
	/** Breadcrumb trail after Home. Defaults to the title before " | Lead Strategy" at this path. */
	crumbs?: Crumb[];
	/** schema.org type of this page: WebPage, CollectionPage, AboutPage, ContactPage, FAQPage... */
	pageType?: string;
	/** Extra JSON-LD nodes (Service, Article, ItemList, FAQPage...) added to the page graph. */
	schema?: Record<string, unknown>[];
}

import { ORG } from '../data/org';
import type { Crumb } from '../data/org';

const { title, description, image, noindex = false, preloadHero = false, crumbs, pageType = 'WebPage', schema = [] } = Astro.props;
const site = 'https://www.leadstrategy.ca/';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';

// Social card: a 1200x630 PNG by default. Pages may pass their own image, but then its size is unknown.
const defaultCard = '/images/og/lead-strategy.png';
const socialImage = new URL(image ?? defaultCard, Astro.site);
const cardSize = image ? null : { width: 1200, height: 630 };
const cardAlt = 'We are Lead Strategy. One Canadian team for small businesses, freelancers and specialist practices.';

// The page name is the title before " | Lead Strategy".
const pageName = title.split(' | ')[0].trim();

const org = {
	'@type': 'Organization',
	'@id': `${site}#org`,
	name: ORG.name,
	alternateName: ORG.alternateName,
	legalName: ORG.legalName,
	description: ORG.description,
	slogan: ORG.slogan,
	foundingDate: ORG.foundingDate,
	url: site,
	email: ORG.email,
	logo: { '@type': 'ImageObject', url: `${site}logo-512.png`, width: 512, height: 512 },
	image: `${site}images/og/lead-strategy.png`,
	areaServed: { '@type': 'Country', name: 'Canada' },
	knowsAbout: ORG.knowsAbout,
	contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: ORG.email, areaServed: 'CA', availableLanguage: ['en'] },
	...(ORG.address ? { address: { '@type': 'PostalAddress', ...ORG.address } } : {}),
	...(ORG.sameAs.length ? { sameAs: ORG.sameAs } : {}),
};
const website = {
	'@type': 'WebSite',
	'@id': `${site}#website`,
	url: site,
	name: 'Lead Strategy',
	inLanguage: 'en-CA',
	publisher: { '@id': `${site}#org` },
};
const webpage = {
	'@type': pageType,
	'@id': `${canonicalURL}#webpage`,
	url: canonicalURL.href,
	name: title,
	description,
	inLanguage: 'en-CA',
	isPartOf: { '@id': `${site}#website` },
	about: { '@id': `${site}#org` },
	primaryImageOfPage: { '@type': 'ImageObject', url: socialImage.href },
	...(isHome ? {} : { breadcrumb: { '@id': `${canonicalURL}#breadcrumb` } }),
};
const breadcrumb = {
	'@type': 'BreadcrumbList',
	'@id': `${canonicalURL}#breadcrumb`,
	itemListElement: [{ name: 'Home', path: '/' }, ...(crumbs ?? [{ name: pageName, path: Astro.url.pathname }])].map((c, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: c.name,
		item: new URL(c.path, Astro.site).href,
	})),
};
// Noindex pages (404, thank-you) get no page-level data.
const graph = noindex ? [org, website] : isHome ? [org, website, webpage, ...schema] : [org, website, webpage, breadcrumb, ...schema];
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="preload" href="/fonts/geist-var.woff2" as="font" type="font/woff2" crossorigin />
{preloadHero && <link rel="preload" href="/images/v6/hero-shop.webp" as="image" imagesrcset="/images/v6/hero-shop-768.webp 768w, /images/v6/hero-shop.webp 1280w" imagesizes="100vw" fetchpriority="high" />}
<link rel="stylesheet" href="/assets/css/v6.css?v=3" />
<link rel="stylesheet" href="/assets/css/v6-site.css?v=2" />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href="/logo-mark.svg?v=1" />
<meta name="theme-color" content="#fdfdfc" />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:locale" content="en_CA" />
<meta property="og:site_name" content="Lead Strategy" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={socialImage} />
{cardSize && <meta property="og:image:type" content="image/png" />}
{cardSize && <meta property="og:image:width" content={String(cardSize.width)} />}
{cardSize && <meta property="og:image:height" content={String(cardSize.height)} />}
{cardSize && <meta property="og:image:alt" content={cardAlt} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
{cardSize && <meta name="twitter:image:alt" content={cardAlt} />}
<link rel="apple-touch-icon" href="/logo-512.png" />
<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
